DATABASE_URL=postgresql+asyncpg://ragforge:ragforge@localhost:5432/ragforge
# Optional isolated database used only when RUN_DATABASE_TESTS=1. The database
# name must end in _test; omit it to derive ragforge_test from DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://ragforge:ragforge@localhost:5432/ragforge_test
RUN_DATABASE_TESTS=0
SECRET_KEY=change-me-generate-a-random-secret

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Required only when using the matching provider.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60

# Keep fastembed for normal runtime. The deterministic backend is intended for
# offline integration tests where external model downloads are undesirable.
EMBEDDING_BACKEND=fastembed
FRONTEND_PORT=3000
AUTH_COOKIE_SECURE=false

# Required only for /ingest/multimodal.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Local or S3-compatible Bronze/Silver/Gold data lake.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=ragforge
MINIO_SECRET_KEY=ragforge123
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

REDIS_URL=redis://localhost:6379/0
QUERY_CACHE_TTL_SECONDS=300
EVENT_STREAM_MAXLEN=512
EVENT_STREAM_TTL_SECONDS=3600
SSE_HEARTBEAT_SECONDS=15
SSE_POLL_SECONDS=1

# Optional: configure these when the Airflow batch profile should auto-start uploads.
# Inside Docker Compose use http://airflow-apiserver:8080.
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.0
RAGFORGE_AIRFLOW_IMAGE_NAME=ragforge-airflow:3.3.0
AIRFLOW_UID=50000
AIRFLOW_API_URL=
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_INGESTION_DAG_ID=ragforge_ingestion
AIRFLOW_API_JWT_SECRET=replace-with-a-random-airflow-jwt-secret
AIRFLOW_FERNET_KEY=
PIPELINE_SERVICE_TOKEN=replace-with-a-random-internal-token

# Optional overrides for the built-in Airflow pipeline commands.
# Every command must keep the {ingestion_run_id} placeholder and print one JSON result.
RAGFORGE_BRONZE_TO_SILVER_CMD=python -m jobs.bronze_to_silver --ingestion-run-id {ingestion_run_id}
RAGFORGE_SILVER_TO_GOLD_CMD=python -m jobs.silver_to_gold --ingestion-run-id {ingestion_run_id}
RAGFORGE_UPSERT_QDRANT_CMD=python -m jobs.upsert_qdrant --ingestion-run-id {ingestion_run_id}

DEBUG_RETURN_CONTEXT=false
MAX_UPLOAD_BYTES=26214400
MAX_MULTIMODAL_PAGES=50
